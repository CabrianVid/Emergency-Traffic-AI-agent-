# RescueFlow AI loads optional environment variables from `.env`.
# NEVER put a real API key or secret in a committed file -- `.env` is
# gitignored; this file holds only documented variable NAMES.

# Path to a SUMO installation (folder containing bin/ and tools/). If unset,
# rescueflow.sumo.env auto-detects common Windows install locations and PATH.
# SUMO_HOME=C:\Program Files (x86)\SUMO

# Optional structured crew-report interpretation. The rule-based path
# and scripted events are available without a key or network access.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Choose the fictional training grid on startup instead of Ljubljana.
# RESCUEFLOW_NETWORK=grid
